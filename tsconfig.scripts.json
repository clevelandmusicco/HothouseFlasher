{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "lib": ["ES2022"],
    "types": ["node"],
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "rootDir": "scripts",
    "outDir": "dist-scripts"
  },
  "include": ["scripts"]
}
